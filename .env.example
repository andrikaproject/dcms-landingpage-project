NEXT_PUBLIC_API_BASE_URL=https://dcms-api.my.id/v1

# Isi true hanya untuk pelaporan error browser di luar build production (backend lokal).
NEXT_PUBLIC_CLIENT_LOGS_ENABLED=

# Alur pending signal (rencana ml-fe.md). Biarkan kosong sampai kontrak backend
# BE-1/BE-2 terverifikasi; frontend tetap memakai endpoint signal lama.
NEXT_PUBLIC_PENDING_SIGNALS_ENABLED=
# Isi true untuk meninjau kartu pending memakai fixture sintetis tanpa backend.
NEXT_PUBLIC_PENDING_SIGNALS_PREVIEW=
# Penilaian model publik hanya dinyalakan setelah gate BE-5.
NEXT_PUBLIC_SIGNAL_ASSESSMENT_ENABLED=
NEXT_PUBLIC_ML_ADMIN_ENABLED=
# Timeframe yang dilayani engine pending backend (pending-v1: 15m dan 1h).
# Timeframe di luar daftar ini memakai endpoint signal lama.
NEXT_PUBLIC_PENDING_SIGNAL_TIMEFRAMES=
# Interval polling status signal, ambang data stale, dan batas backoff (ms).
NEXT_PUBLIC_SIGNAL_POLL_INTERVAL_MS=
NEXT_PUBLIC_SIGNAL_STALE_AFTER_MS=
NEXT_PUBLIC_SIGNAL_MAX_BACKOFF_MS=
